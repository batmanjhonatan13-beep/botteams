# ---------------------------------------------------------------- o modelo
# Onde o Ollama esta. Se ele roda na sua maquina e a API no Docker, use
# host.docker.internal. Se roda no servidor SUSE, ponha o endereco dele.
MODELO_URL=http://host.docker.internal:11434
# O nome EXATO como o `ollama list` mostra no seu servidor.
MODELO_NOME=qwen2.5:14b
# 14b em CPU e lento: melhor esperar do que morrer de timeout no primeiro turno.
MODELO_SEGUNDOS=300
# Teto da janela. A API pede a MENOR janela que cabe cada prompt; isto e so o limite.
MODELO_JANELA_MAXIMA=8192

# ---------------------------------------------------------------- docs internas
ACERVO_PASTA=/app/acervo
ACERVO_EXTENSOES=.md,.txt,.html,.htm,.rst,.adoc

# ---------------------------------------------------------------- Confluence (so leitura)
# Cloud:     https://suaempresa.atlassian.net/wiki
# Server/DC: https://confluence.suaempresa.com
CONFLUENCE_URL=
CONFLUENCE_USUARIO=
CONFLUENCE_TOKEN=
# Os espacos que entram no acervo. Cada time tem o seu; ponha os seus PARCEIROS aqui
# tambem, porque o bot ajuda os outros times e a resposta deles mora no espaco deles.
# Vazio = todos os espacos que a credencial enxerga.
CONFLUENCE_ESPACOS=SRE,PAGAMENTOS,CATALOGO
# O seu. Nao filtra nada: so desempata quando a mesma palavra aparece em dois espacos.
CONFLUENCE_ESPACO_DE_CASA=SRE
CONFLUENCE_PAGINAS=200

# ---------------------------------------------------------------- o time
PERFIL_ARQUIVO=/app/perfil.md
MEMORIA_PASTA=/app/memoria

# ---------------------------------------------------------------- Bot Framework Emulator
# Vazio quando a API roda direto no Windows. Com a API no Docker Desktop, use
# host.docker.internal: o localhost que o Emulator manda nao e o do container.
EMULADOR_HOST=
